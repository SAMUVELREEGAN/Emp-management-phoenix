OFFICE_START_TIME=09:30
OFFICE_END_TIME=18:00
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
GEOCODING_PROVIDER=osm
GOOGLE_MAPS_API_KEY=
